# "mock" (default) runs entirely against MSW mocks. "live" talks to services/api.
# `pnpm dev` = mocks; `pnpm dev:live` (or `make web-live` at the repo root) = live API.
VITE_API_MODE=mock
# Live mode: leave empty to go through the Vite dev proxy (same origin, so the session cookie
# and CSRF Origin check just work). Set a full URL only when serving the SPA without the proxy.
VITE_API_BASE_URL=
# Where the dev server proxies /v1 (live mode only).
VITE_API_PROXY_TARGET=http://localhost:8080
