# Copy to .env (git-ignored). No real secrets here. Defaults match docker-compose.yml.

# --- infra ---
DATABASE_URL=postgres://alpine_app:alpine_app@localhost:5432/alpine?sslmode=disable
DATABASE_ADMIN_URL=postgres://alpine:alpine@localhost:5432/alpine?sslmode=disable
REDIS_URL=redis://localhost:6379/0
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=alpine-artifacts
S3_ACCESS_KEY=alpine
S3_SECRET_KEY=alpine-secret
# Base URL the web uses for artifact links (unsigned in Phase 0); defaults to ${S3_ENDPOINT}/${S3_BUCKET}
# S3_PUBLIC_URL=http://localhost:9000/alpine-artifacts
# POSTGRES_PORT=5433   # if a local Postgres already uses 5432 (then update the two URLs above)

# --- API ---
API_ADDR=:8080
PUBLIC_API_URL=http://localhost:8080
APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# DATABASE_REPLICA_URL=

# --- auth (real service: Google/GitHub OAuth, sessions, RBAC, API keys) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL defaults to ${PUBLIC_API_URL}/v1/auth/google/callback
GOOGLE_HOSTED_DOMAINS=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URL defaults to ${PUBLIC_API_URL}/v1/auth/github/callback
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48
API_KEY_PEPPER=change-me-generate-with-openssl-rand-base64-48
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TTL=168h
SESSION_ABSOLUTE_TTL=720h
AUTH_ALLOW_SIGNUP=true
AUTH_MAGIC_LINK_ENABLED=false
AUTH_MAGIC_LINK_SIGNUP=false
# POST /v1/auth/dev-login (local only)
AUTH_DEV_LOGIN=true
TRUST_PROXY_HEADERS=false
# MAIL_FROM defaults to "Alpine <no-reply@alpine.local>"
# Mail (magic links, invitations): logged to stdout unless SMTP_ADDR is set
# SMTP_ADDR=localhost:1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Local-only shortcut: requests WITHOUT a session cookie or Authorization header act as the seeded
# dev@alpine.local owner (needs `make seed`). curl must send X-CSRF-Token: dev-stub-csrf on writes.
# Never in prod.
AUTH_DEV_STUB=false
# AUTH_DEV_LOGIN_EMAIL=dev@alpine.local

# --- GitHub App ---
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_APP_ID=
# "<app-slug>[bot]"
GITHUB_APP_BOT_LOGIN=
GITHUB_APP_PRIVATE_KEY_FILE=
# Worker SCM: stub (default; local runs never write to GitHub) | github (real GitHub App: needs
# GITHUB_APP_ID, GITHUB_APP_BOT_LOGIN, GITHUB_APP_PRIVATE_KEY_FILE). GITHUB_LIVE=true is a legacy alias.
SCM=stub

# --- Sentry ---
# Installation -> org and project -> repo routing live in the sentry_installations /
# sentry_project_repos tables (`make seed` adds dev-sentry-installation and project web-frontend).
SENTRY_CLIENT_SECRET=dev-sentry-secret

# --- gates ---
# stub (default; fabricated results) | real (packages/gates runs the repo's configured gates in the
# ticket checkout, so it needs a sandbox checkout at RunRequest.RepoDir)
GATES=stub
# GATES_ARTIFACTS_DIR=/tmp/alpine-gates
# Gates-only values for names a repo declares in gate_runner.extra_env, as GATES_ENV_<NAME>=value.
# They reach gate commands only (never the implementer sandbox or other worker env).
# GATES_ENV_PLAYWRIGHT_BASE_URL=http://localhost:3000

# --- Models: OpenAI via LiteLLM ---
# stub (no LLM calls) | llm
ALPINE_AGENT_MODE=stub
# platform key (LiteLLM); orgs may bring their own (BYOK)
OPENAI_API_KEY=
LLM_BASE_URL=http://localhost:4000/v1
# LiteLLM master key
LLM_API_KEY=sk-alpine-dev
LLM_BYOK_IN_BODY=true
LLM_MODELS_TRIAGE=gpt-5-mini,gpt-4.1-mini
LLM_MODELS_REFINE=gpt-5-mini,gpt-4.1
LLM_MODELS_PRIORITIZE=gpt-5-nano,gpt-4.1-mini
LLM_MODELS_IMPLEMENT=gpt-5,gpt-4.1
# must differ from the implementer
LLM_MODELS_REVIEW=o3,gpt-5-mini
LLM_ALLOW_PLATFORM_KEY=true
LLM_LOG_PROMPTS=false
LLM_REDACT_OUTBOUND=true
# base64 32 bytes: `openssl rand -base64 32` (BYOK envelope encryption)
ALPINE_LOCAL_KEK=

# --- limits & budgets ---
LIMIT_ORG_MAX_PARALLEL_TICKETS=5
LIMIT_REPO_MAX_PARALLEL_TICKETS=3

# --- sandboxes ---
# docker | e2b
RUNNER=docker
E2B_API_KEY=
RUNNER_DOCKER_IMAGE=node:22-bookworm-slim

# --- worker stub knobs ---
STUB_TURNS_PER_ATTEMPT=3
STUB_GATE_FAILURES=1

# --- seed (make seed) ---
# SEED_GITHUB_REPO=acme/widgets
# SEED_GITHUB_REPO_ID=777
# SEED_GITHUB_INSTALLATION_ID=42
# SEED_SENTRY_INSTALLATION=dev-sentry-installation
# SEED_SENTRY_PROJECT=web-frontend
# SEED_FACTORY_YAML=../../.alpine/factory.yaml

# --- telemetry (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
