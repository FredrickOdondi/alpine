# Live mode: real agents, real implementer sandbox, real gates, real PRs on ONE test repo.
# cp .env.live.example .env.live  (git-ignored; the Makefile loads it after .env)
# Export OPENAI_API_KEY in your shell; never put it in a committed file.
ALPINE_AGENT_MODE=live
LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODELS_TRIAGE=gpt-4.1-mini
LLM_MODELS_REFINE=gpt-4.1-mini
LLM_MODELS_PRIORITIZE=gpt-4.1-mini
LLM_MODELS_IMPLEMENT=gpt-4.1
# must differ from the implementer (the worker refuses to start otherwise)
LLM_MODELS_REVIEW=gpt-4.1-mini
LLM_MAX_OUTPUT_TOKENS_TRIAGE=800
LLM_MAX_OUTPUT_TOKENS_REFINE=1500
LLM_MAX_OUTPUT_TOKENS_PRIORITIZE=600
LLM_MAX_OUTPUT_TOKENS_IMPLEMENT=4000
LLM_MAX_OUTPUT_TOKENS_REVIEW=1500
# per-ticket caps (the repo's .alpine/factory.yaml limits apply too)
TICKET_MAX_TURNS=25
TICKET_MAX_GATE_ITERATIONS=3
TICKET_MAX_COST_USD=1.50
TICKET_MAX_TOKENS=800000
BUDGET_ORG_DAILY_USD=3
BUDGET_ORG_MONTHLY_USD=10
# open PRs with your gh login, only on these repos
SCM=gh
SCM_GH_ALLOWED_REPOS=your-github-user/alpine-testbed
GATES=real
# implementer sandbox: clones land in WORKSPACE_ROOT; run_command executes in this image with no network
IMPLEMENTER_IMAGE=golang:1.26-alpine
WORKSPACE_ROOT=/tmp/alpine-workspaces
# IMPLEMENTER_COMMAND_TIMEOUT=3m
# RUNNER_DOCKER_BIN=docker
# ALPINE_GIT_AUTHOR=Alpine Bot <alpine-bot@users.noreply.github.com>
AUTH_DEV_STUB=true
