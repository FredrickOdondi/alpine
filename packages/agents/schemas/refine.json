{
  "type": "object",
  "additionalProperties": false,
  "required": ["problem", "repro_steps", "acceptance_criteria", "out_of_scope", "reproduced", "blast_radius", "blast_radius_justification", "priority", "size", "confidence", "likely_files"],
  "properties": {
    "problem": { "type": "string", "maxLength": 1200 },
    "repro_steps": { "type": "array", "items": { "type": "string" }, "maxItems": 15 },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 10 },
    "out_of_scope": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
    "reproduced": { "type": "boolean" },
    "blast_radius": { "type": "integer", "minimum": 1, "maximum": 4 },
    "blast_radius_justification": { "type": "string", "maxLength": 600 },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "size": { "type": "string", "enum": ["XS", "S", "M", "L", "XL"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "likely_files": { "type": "array", "items": { "type": "string" }, "maxItems": 30 }
  }
}
