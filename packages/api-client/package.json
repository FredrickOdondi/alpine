{
  "name": "@alpine/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the Alpine REST API, generated from api/openapi.yaml",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi.yaml -o src/schema.gen.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.8.0",
    "typescript": "~5.8.3"
  }
}
